# ============================================================================
#  VPN Robot — Environment Configuration
#  Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ---- General ----
APP_NAME=VPN Robot
ENVIRONMENT=production          # development | staging | production
DEBUG=false
TIMEZONE=Asia/Tehran
SECRET_KEY=change-me-to-a-long-random-string-use-openssl-rand-hex-32
API_BASE_URL=https://api.example.com
DASHBOARD_BASE_URL=https://panel.example.com

# ---- Database (PostgreSQL) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vpnrobot
POSTGRES_USER=vpnrobot
POSTGRES_PASSWORD=change-me-strong-db-password
# Async URL is derived in settings; this is the canonical DSN.
DATABASE_URL=postgresql+asyncpg://vpnrobot:change-me-strong-db-password@postgres:5432/vpnrobot

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- JWT / Auth ----
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# Separate signing key for refresh tokens (defense in depth)
JWT_REFRESH_SECRET_KEY=change-me-to-a-different-long-random-string

# ---- Telegram ----
CUSTOMER_BOT_TOKEN=000000:replace-with-customer-bot-token
ADMIN_BOT_TOKEN=000000:replace-with-admin-bot-token
# Comma-separated Telegram numeric IDs that bootstrap as super admins
BOOTSTRAP_SUPER_ADMINS=123456789
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret
USE_WEBHOOK=false              # false = long polling (simpler for first deploy)

# ---- Payment Gateways ----
# Active provider: zarinpal | idpay | nextpay
PAYMENT_PROVIDER=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
IDPAY_API_KEY=
IDPAY_SANDBOX=true
NEXTPAY_API_KEY=
PAYMENT_CALLBACK_URL=https://api.example.com/api/v1/payments/callback

# ---- Inventory ----
LOW_INVENTORY_THRESHOLD=5

# ---- File uploads ----
MEDIA_ROOT=/app/media
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,pdf

# ---- CORS (dashboard origins, comma-separated) ----
CORS_ORIGINS=https://panel.example.com,http://localhost:3000

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=120
